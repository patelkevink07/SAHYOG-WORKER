{
  "entities": {
    "Worker": {
      "title": "Worker",
      "description": "A cooperative worker profile",
      "type": "object",
      "properties": {
        "isOnline": {
          "type": "boolean",
          "description": "Live duty availability status of the worker on citizen apps"
        },
        "name": {
          "type": "string",
          "description": "Full name of the worker"
        },
        "trade": {
          "type": "string",
          "description": "Primary trade of the worker"
        }
      }
    },
    "Booking": {
      "title": "Booking",
      "description": "A service booking between a citizen and a cooperative worker",
      "type": "object",
      "properties": {
        "workerId": {
          "type": "string",
          "description": "ID of the assigned worker, e.g. worker-1"
        },
        "status": {
          "type": "string",
          "enum": ["requested", "accepted", "in_progress", "completed", "cancelled", "rejected"],
          "description": "Lifecycle state of the booking"
        },
        "title": {
          "type": "string",
          "description": "Service title or description summary"
        },
        "category": {
          "type": "string",
          "description": "Trade category of the booking"
        },
        "urgency": {
          "type": "string",
          "description": "Priority or scheduling urgency"
        },
        "customerName": {
          "type": "string",
          "description": "Name of the requesting citizen"
        },
        "customerPhone": {
          "type": "string",
          "description": "Phone number of the requesting citizen"
        },
        "address": {
          "type": "string",
          "description": "Physical site address"
        },
        "area": {
          "type": "string",
          "description": "Locality or sector name"
        },
        "price": {
          "type": "number",
          "description": "Tariff amount in INR"
        },
        "description": {
          "type": "string",
          "description": "Detailed problem description"
        }
      },
      "required": ["workerId", "status"]
    },
    "Dispute": {
      "title": "Dispute",
      "description": "A booking dispute between citizen and cooperative worker",
      "type": "object",
      "properties": {
        "refNumber": { "type": "string" },
        "bookingId": { "type": "string" },
        "bookingRef": { "type": "string" },
        "workerId": { "type": "string" },
        "customerPhone": { "type": "string" },
        "complainantName": { "type": "string" },
        "respondentName": { "type": "string" },
        "trade": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "escrowAmount": { "type": "number" },
        "severity": { "type": "string" },
        "lodgedBy": { "type": "string" },
        "lodgedDate": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["open", "under_mediation", "resolved"]
        },
        "hasWorkerUnreadUpdate": { "type": "boolean" },
        "hasCustomerUnreadUpdate": { "type": "boolean" }
      },
      "required": ["bookingId", "workerId", "status"]
    }
  },
  "firestore": {
    "/workers/{workerId}": {
      "schema": "Worker",
      "description": "Collection of trade workers with their live duty status and profiles"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collection of citizen service bookings dispatched to cooperative workers"
    },
    "/disputes/{disputeId}": {
      "schema": "Dispute",
      "description": "Collection of consumer booking disputes mediated by the cooperative board"
    }
  }
}
